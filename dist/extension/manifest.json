{
  "manifest_version": 3,
  "name": "FocusBot - Neural Sound Waves & Smart Pomodoro",
  "version": "1.3.1",
  "description": "Synthesizes binaural beats, Solfeggio frequencies, and ambient noise offline with a Smart Pomodoro timer.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["client/focus-bot.css"],
      "js": ["client/focus-bot.js"],
      "run_at": "document_end",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "client/icons/icon-16.png",
    "32": "client/icons/icon-32.png",
    "48": "client/icons/icon-48.png",
    "128": "client/icons/icon-128.png"
  },
  "action": {
    "default_title": "FocusBot",
    "default_popup": "client/popup.html",
    "default_icon": {
      "16": "client/icons/icon-16.png",
      "32": "client/icons/icon-32.png",
      "48": "client/icons/icon-48.png",
      "128": "client/icons/icon-128.png"
    }
  },
  "developer": {
    "name": "FocusBot Team",
    "url": "https://focus-bot.workers.dev"
  },
  "homepage_url": "https://focus-bot.workers.dev"
}