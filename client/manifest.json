{
  "manifest_version": 3,
  "name": "FocusBot - Autonomous Deep Work Suite",
  "version": "1.3.0",
  "description": "Neural Frequency Synthesizer + Smart Pomodoro + Deep Work Analytics. On-chain licensed (12 EUR/year, Bitcoin).",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["focus-bot.css"],
      "js": ["focus-bot.js"],
      "run_at": "document_end",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "permissions": ["storage", "notifications"],
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_title": "FocusBot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "developer": {
    "name": "FocusBot Team",
    "url": "https://focus-bot.workers.dev"
  },
  "homepage_url": "https://focus-bot.workers.dev"
}
